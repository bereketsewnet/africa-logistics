# ─── Dineos AI Agent ────────────────────────────────────────────────────────
dineos-agent.lula.com.et {
    encode zstd gzip
    request_body {
        max_size 20MB
    }

    redir /miniapp /miniapp/ 308

    handle_path /miniapp/* {
        reverse_proxy dineos_miniapp:80
    }

    handle {
        reverse_proxy dineos_api:8765
    }
}

# ─── The Oracle AI Platform ─────────────────────────────────────────────────
theoracle.lula.com.et {
    encode zstd gzip

    request_body {
        max_size 25MB
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    @oracle_api path /api/* /docs* /redoc* /openapi.json
    handle @oracle_api {
        reverse_proxy oracle_backend:8000
    }

    handle {
        reverse_proxy oracle_frontend:80
    }
}

# ─── Jarvis Scheduling Assistant ────────────────────────────────────────────
# Upstream is the `jarvis_app` container (project: /PRODUCTION PROJECTS/JARVIS),
# which joins this network as `edge` in its docker-compose.yml.
jarvis.lula.com.et {
    encode zstd gzip

    request_body {
        # Telegram voice notes (SRS 3.2.1) arrive as file downloads, but keep
        # headroom for multipart uploads during the Phase 4 voice flow.
        max_size 25MB
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    reverse_proxy jarvis_app:8000
}

# ─── Jarvis — Staging ───────────────────────────────────────────────────────
# A complete second Jarvis with its own bot, database and Google redirect URI.
# Phase 4 writes to real Google Calendars, so booking code is exercised here
# before production ever sees it.
jarvis-staging.lula.com.et {
    encode zstd gzip

    request_body {
        max_size 25MB
    }

    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        # Kept out of search results: staging is for us, not for the world.
        X-Robots-Tag "noindex, nofollow"
    }

    reverse_proxy jarvis_staging_app:8000
}

# ─── BernOS editor licences (Nathan, 2026-10-07) ─────────────────────────────
# One small JSON file per client site. A client editor asks this address whether it may publish.
# Files: caddy_data volume, folder bernos-editor/ (host: /var/lib/docker/volumes/africalogistics_caddy_data/_data/bernos-editor/).
# Switch a client off: set "active": false in its file. No reload needed.
editor.bernos.systems {
    header {
        -Server
        X-Content-Type-Options nosniff
        X-Robots-Tag "noindex, nofollow"
        Cache-Control "no-store"
    }
    redir /admin /admin/ 308
    handle_path /admin/* {
        basic_auth {
            nathan $2a$14$Xg5ulpIvbqU66JY8tthET.eVufwqZMy.6I0odmyAcjI3hZjhi55qa
        }
        reverse_proxy bernos_editor_admin:8080
    }
    @json path_regexp ^/[a-z0-9-]+\.json$
    handle @json {
        root * /data/bernos-editor
        file_server
    }
    @igapp path /ig/connect /ig/callback /ig/disconnect
    handle @igapp {
        rewrite /ig/connect /ig-connect.php?{query}
        rewrite /ig/callback /ig-callback.php?{query}
        rewrite /ig/disconnect /ig-disconnect.php?{query}
        reverse_proxy bernos_editor_admin:8080
    }
    @igfile path_regexp ^/ig/([a-z0-9-]+\.json|m/[a-z0-9-]+/[0-9_]+\.jpg)$
    handle @igfile {
        header Access-Control-Allow-Origin "*"
        header Cache-Control "public, max-age=300"
        root * /data/bernos-editor
        file_server
    }
    handle {
        respond 404
    }
}
